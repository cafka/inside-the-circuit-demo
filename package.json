{
  "name": "inside-the-circuit",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Learn electronics through source-backed interactive board models and hybrid visual identity",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "node experiments/board-library/build.mjs",
    "start": "node experiments/board-library/server.mjs",
    "catalog:restore": "node scripts/restore-release-catalog.mjs",
    "library:sync": "node scripts/sync-library.mjs",
    "test:release": "node --test tests/release*.test.mjs experiments/board-library/photo-onboarding-test.mjs experiments/board-library/name-onboarding-test.mjs experiments/board-library/selection-whole-policy-test.mjs tests/reconstruction.test.mjs",
    "test": "node --test tests/release*.test.mjs experiments/board-library/photo-onboarding-test.mjs experiments/board-library/name-onboarding-test.mjs experiments/board-library/selection-whole-policy-test.mjs tests/reconstruction.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "three": "0.187.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}